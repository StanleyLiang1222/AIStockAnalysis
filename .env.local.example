# Auth.js（Google OAuth）
# 到 https://console.cloud.google.com/ 建立 OAuth 2.0 用戶端 ID（應用程式類型：網頁應用程式）
# 授權的重新導向 URI 需加入：
#   本機開發：http://localhost:3000/api/auth/callback/google
#   正式環境：https://<你的網域>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js session 加密用的隨機字串，可用 `npx auth secret` 產生
AUTH_SECRET=

# Vercel Postgres
# 在 Vercel Dashboard 建立 Postgres 資料庫並連接到此專案後，
# Vercel 會自動注入 POSTGRES_URL 等環境變數（本機開發可用 `vercel env pull .env.local` 取得）
POSTGRES_URL=
